# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Use the current Gemini Pro model name from AI Studio (do not hard-code in code).
GEMINI_MODEL=gemini-3.1-pro-preview
# Per-call timeout in seconds.
GEMINI_TIMEOUT_S=150
# Optional: low | high for models that support thinking levels. Blank = model default.
GEMINI_THINKING_LEVEL=low
# Accept -, . as date separators on QS-F-049 (False) or only / (True).
STRICT_DATE_SEPARATOR=false
